{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "headers": [
    {
      "source": "/funnel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/funnel/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/organic/instagram",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/organic/instagram/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/home"
    },
    {
      "source": "/quiet-reading-room",
      "destination": "/apps/main"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/apps/assets/$1"
    },
    {
      "source": "/admin",
      "destination": "/apps/admin"
    },
    {
      "source": "/book",
      "destination": "/apps/book"
    },
    {
      "source": "/book/(.*)",
      "destination": "/apps/book/$1"
    },
    {
      "source": "/audio",
      "destination": "/apps/audiobook"
    },
    {
      "source": "/audio/(.*)",
      "destination": "/apps/audiobook/$1"
    },
    {
      "source": "/wallpapers",
      "destination": "/apps/wallpapers"
    },
    {
      "source": "/wallpapers/(.*)",
      "destination": "/apps/wallpapers/$1"
    },
    {
      "source": "/bundle",
      "destination": "/apps/bundle"
    },
    {
      "source": "/thank-you",
      "destination": "/apps/thank-you"
    },
    {
      "source": "/privacy",
      "destination": "/apps/privacy"
    },
    {
      "source": "/deleteaccount",
      "destination": "/apps/delete-account"
    },
    {
      "source": "/delete-account",
      "destination": "/apps/delete-account"
    },
    {
      "source": "/pricing",
      "destination": "/apps/pricing"
    },
    {
      "source": "/refund",
      "destination": "/apps/refund"
    },
    {
      "source": "/terms",
      "destination": "/apps/terms"
    },
    {
      "source": "/support",
      "destination": "/apps/support"
    },
    {
      "source": "/conversion",
      "destination": "/apps/conversion"
    },
    {
      "source": "/conversion/(.*)",
      "destination": "/apps/conversion/$1"
    },
    {
      "source": "/funnel",
      "destination": "/apps/funnel"
    },
    {
      "source": "/funnel/(.*)",
      "destination": "/apps/funnel/$1"
    },
    {
      "source": "/organic/instagram",
      "destination": "/apps/organic-instagram"
    },
    {
      "source": "/organic/instagram/(.*)",
      "destination": "/apps/organic-instagram/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/main/$1"
    }
  ]
}
